# Copy this file to .env and fill in your real values. Never commit .env itself.

# SMTP settings — for Gmail, use smtp.gmail.com, port 587, and a 16-character
# "App Password" (Google Account > Security > 2-Step Verification > App passwords).
# Your normal Gmail password will NOT work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your16charapppassword

# Where contact form messages should be delivered
CONTACT_TO_EMAIL=swati.singh.0064@gmail.com

# Backend port
PORT=5000
